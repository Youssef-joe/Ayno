# Polyglot Production Configuration
# Copy to .env and fill in actual values

# ============================================================================
# REQUIRED - Application Secrets
# ============================================================================

# Generate with: openssl rand -hex 32
SECRET_KEY_BASE=your-secret-key-base-here-generate-randomly

# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-generate-randomly

# ============================================================================
# Application Configuration
# ============================================================================

# Port on which the Elixir server listens
APP_PORT=4000

# Public hostname (used in URL generation)
APP_HOST=localhost

# Environment: dev, staging, prod
MIX_ENV=prod

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================================================
# CORS Configuration
# ============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://app.example.com

# ============================================================================
# PostgreSQL Configuration
# ============================================================================

# PostgreSQL host
DB_HOST=postgres

# PostgreSQL port
DB_PORT=5432

# PostgreSQL username
DB_USER=polyglot

# PostgreSQL password
DB_PASSWORD=polyglot

# PostgreSQL database name
DB_NAME=polyglot_prod

# Connection pool size
DB_POOL_SIZE=10

# SSL for database connection (true/false)
DB_SSL=false

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis host
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis database number (0-15)
REDIS_DB=0

# ============================================================================
# Go Processor Configuration
# ============================================================================

# URL of the Go processor service
GO_PROCESSOR_URL=http://go-processor:8080

# Analytics backend for Go processor (none|clickhouse)
ANALYTICS_BACKEND=none

# ClickHouse HTTP endpoint (used when ANALYTICS_BACKEND=clickhouse)
CLICKHOUSE_HTTP_URL=http://clickhouse:8123

# ClickHouse database and credentials
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# ClickHouse table for event analytics pipeline
CLICKHOUSE_TABLE=event_analytics

# ClickHouse batching controls
CLICKHOUSE_BATCH_SIZE=500
CLICKHOUSE_FLUSH_INTERVAL_MS=2000
CLICKHOUSE_QUEUE_SIZE=10000
CLICKHOUSE_AUTO_CREATE=true

# ============================================================================
# Monitoring & Error Tracking (Optional)
# ============================================================================

# Sentry DSN for error tracking (optional, leave empty to disable)
SENTRY_DSN=

# ============================================================================
# API Keys & Authentication
# ============================================================================

# Require tenant and user records from Postgres in auth flow
AUTH_REQUIRE_TENANT_CONFIG=true
AUTH_REQUIRE_USER_RECORDS=true

# Allow old in-memory/demo API key pattern in non-prod only
ALLOW_LEGACY_API_KEYS=false

# Redis TTLs for session and presence state
SESSION_TTL_SECONDS=3600
PRESENCE_TTL_SECONDS=120
HISTORY_TTL_SECONDS=3600
HISTORY_MAX_EVENTS=1000

# Seed defaults used by `mix ecto.setup`
SEED_APP_ID=demo-app
SEED_APP_NAME=Demo App
SEED_USER_ID=demo-user
SEED_API_KEY=demo-app-local-key
